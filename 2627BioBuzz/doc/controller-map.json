{
  "robotName": "FTC 32722 BioBuzz",
  "subtitle": "PlayStation Controller Layout • DriverControlled (TeleOp) • E-Stop active in all OpModes",
  "buttons": {
    "L2": {
      "psName": "L2 Trigger",
      "ftcCode": "gamepad.left_trigger",
      "title": "L2 + R2 — GLOBAL E-STOP",
      "subtitle": "Pull both triggers >85% for 150ms",
      "category": "estop",
      "tableAction": "Global Emergency Stop (with R2)",
      "tableNotes": "Pull both L2 + R2 >85% for 150 ms (gamepad1 or gamepad2, all OpModes)"
    },
    "R2": {
      "psName": "R2 Trigger",
      "ftcCode": "gamepad.right_trigger",
      "title": "R2 + L2 — GLOBAL E-STOP",
      "subtitle": "Cuts all motor power immediately",
      "category": "estop",
      "tableAction": "Global Emergency Stop (with L2)",
      "tableNotes": "Latches all subsystems to 0 power until SHARE is held 0.5 s"
    },
    "L1": {
      "psName": "L1 Bumper",
      "ftcCode": "gamepad.left_bumper",
      "title": "L1 — Slow Speed (50%)",
      "subtitle": "Precision driving multiplier",
      "category": "drive",
      "tableAction": "Slow Drive Speed (50%)",
      "tableNotes": "Sets speedMultiplier = RobotConstants.SLOW_SPEED_MULTIPLIER"
    },
    "R1": {
      "psName": "R1 Bumper",
      "ftcCode": "gamepad.right_bumper",
      "title": "R1 — Fast Speed (100%)",
      "subtitle": "Full driving speed multiplier",
      "category": "drive",
      "tableAction": "Fast Drive Speed (100%)",
      "tableNotes": "Sets speedMultiplier = RobotConstants.FAST_SPEED_MULTIPLIER"
    },
    "SHARE": {
      "psName": "SHARE / CREATE",
      "ftcCode": "gamepad.back",
      "title": "SHARE — Hold 0.5s: Clear E-Stops",
      "subtitle": "Releases global & subsystem E-Stops",
      "category": "estop_reset",
      "tableAction": "Clear / Reset All E-Stops",
      "tableNotes": "Hold for 500 ms on gamepad1 or gamepad2 to release E-Stop latches"
    },
    "OPTIONS": {
      "psName": "OPTIONS",
      "ftcCode": "gamepad.start",
      "title": "OPTIONS — FTC System Reserved",
      "subtitle": "OPTIONS + X/O assigns gamepad 1/2",
      "category": "unassigned",
      "tableAction": "Reserved by FTC Driver Station",
      "tableNotes": "OPTIONS + Cross/Circle binds Gamepad 1 / Gamepad 2"
    },
    "DPAD": {
      "psName": "D-Pad (Up/Down/Left/Right)",
      "ftcCode": "gamepad.dpad_*",
      "title": "D-Pad — Unassigned",
      "subtitle": "Available for future mechanisms",
      "category": "unassigned",
      "tableAction": "Unassigned",
      "tableNotes": "Edit doc/controller-map.json when assigned"
    },
    "LEFT_STICK": {
      "psName": "Left Stick (L3 axis)",
      "ftcCode": "left_stick_x / left_stick_y",
      "title": "Left Stick — Move / Drive",
      "subtitle": "Mecanum: Fwd/Back + Strafe | Tank: Left",
      "category": "drive",
      "tableAction": "Mecanum: Forward/Strafe | Tank: Left Drive",
      "tableNotes": "5% deadzone applied (RobotConstants.GAMEPAD_DEADZONE)"
    },
    "RIGHT_STICK": {
      "psName": "Right Stick (R3 axis)",
      "ftcCode": "right_stick_x / right_stick_y",
      "title": "Right Stick — Turn / Drive",
      "subtitle": "Mecanum: Turn (X) | Tank: Right (Y)",
      "category": "drive",
      "tableAction": "Mecanum: Turn (X) | Tank: Right Drive (Y)",
      "tableNotes": "5% deadzone applied (RobotConstants.GAMEPAD_DEADZONE)"
    },
    "TRIANGLE": {
      "psName": "△ Triangle",
      "ftcCode": "gamepad.y",
      "title": "△ — Intake Reverse",
      "subtitle": "Manual reverse pulse (jam clear)",
      "category": "intake",
      "tableAction": "Intake Reverse (Jam Clear)",
      "tableNotes": "Runs a 200 ms reverse pulse via intake.triggerReverse()"
    },
    "CIRCLE": {
      "psName": "○ Circle",
      "ftcCode": "gamepad.b",
      "title": "○ — Reset Odometry Pose",
      "subtitle": "Sets (X, Y, Heading) to (0, 0, 0°)",
      "category": "odometry",
      "tableAction": "Reset Odometry Pose to (0, 0, 0°)",
      "tableNotes": "Active when RobotConstants.MECANUM_ODO_INSTALLED is true"
    },
    "CROSS": {
      "psName": "✕ Cross",
      "ftcCode": "gamepad.a",
      "title": "✕ — Toggle FlyWheel On / Off",
      "subtitle": "1st press clears FlyWheel Auto E-Stop",
      "category": "flywheel",
      "tableAction": "Toggle FlyWheel On / Off",
      "tableNotes": "If FlyWheel Auto E-Stop is active, 1st press clears latch safely"
    },
    "SQUARE": {
      "psName": "□ Square",
      "ftcCode": "gamepad.x",
      "title": "□ — Toggle Intake On / Off",
      "subtitle": "1st press clears Intake Auto E-Stop",
      "category": "intake",
      "tableAction": "Toggle Intake Enabled / Disabled",
      "tableNotes": "If Intake Auto E-Stop is active, 1st press clears latch safely"
    }
  }
}
